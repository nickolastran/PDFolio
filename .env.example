# All optional. Defaults shown.
MAX_FILE_MB=50            # per file
MAX_TOTAL_MB=200          # per request
MAX_FILES=20              # per request
MAX_PAGES=2000            # per PDF
MAX_RENDER_DPI=300
MAX_IMAGE_PIXELS=100000000
MAX_UNZIPPED_MB=500       # zip/docx/epub contents
MAX_ZIP_ENTRIES=2000
MAX_ZIP_RATIO=100         # max compression ratio per archive entry
JOB_TTL_MINUTES=60        # files are deleted after this
JOB_TIMEOUT_SECONDS=300   # wall clock and CPU per job
JOB_MEMORY_MB=4096        # address-space limit per job
JOB_MAX_OUTPUT_MB=1024    # largest file a job may write
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=50
RATE_LIMIT=30/minute      # job creation, per IP
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173
COOKIE_SECURE=true        # keep true; browsers allow Secure cookies on http://localhost
DATA_DIR=backend/data
MAX_RENDER_PAGES=500       # PDF to images/slides

# Optional AI tools (Summarize, Translate, Markdown with AI). Off unless both are set.
# The text of the user's PDF is sent to Anthropic's API; users must tick a consent box first.
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_MAX_CHARS=400000
